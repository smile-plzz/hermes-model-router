# Copy to .env (in this directory or $HERMES_HOME) and fill in your free-tier keys.
# Real environment variables always win over this file.
# A provider with no key is skipped entirely rather than failing at call time.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
# Either name works; GOOGLE_API_KEY is checked first.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Nous needs no key here: it goes through the local `hermes` CLI, which
# authenticates on its own.
