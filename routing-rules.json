  "scoring": {
    "keyword_match_bonus": 10,
    "keyword_partial_bonus": 3,
    "prefer_provider_bonus": 5,
    "free_provider_bonus": 8,
    "rate_limit_penalty": -20,
    "fallback_used_penalty": -3,
    "default_tier_if_ambiguous": "small",
    "ask_user_threshold": 6,
    "min_confidence_to_skip_ask": 12
  },
  "when_confused": {
    "ask_user": true,
    "prompt_template": "This task could be [{options}]. Which fits best? (or say 'other' and describe it)",
    "timeout_seconds": 30,
    "default_on_timeout": "small",
    "default_provider_on_timeout": "groq"
  }
