{
  "version": 3,
  "task_types": {
    "simple": {
      "description": "Greeting, acknowledgement, short Q&A",
      "precedence": 10,
      "target_class": "small",
      "want_strengths": ["fast"],
      "prefer_provider": "groq",
      "max_words": 8,
      "strong": [
        "hello", "hey", "thanks", "thank you", "what's up", "how are you",
        "good morning", "good night", "never mind", "no worries"
      ],
      "weak": ["hi", "yo", "sup", "ok", "okay", "sure", "yes", "no", "cool", "nice", "done", "cheers", "lol"]
    },
    "summary": {
      "description": "Summarization, extraction, condensation",
      "precedence": 50,
      "target_class": "small",
      "want_strengths": ["fast"],
      "prefer_provider": "groq",
      "strong": [
        "summarize", "summary", "tl;dr", "tldr", "key points", "main idea",
        "in a nutshell", "boil down", "condense", "recap", "key takeaways"
      ],
      "weak": ["extract", "shorten", "gist", "overview", "digest", "brief", "highlights"]
    },
    "code": {
      "description": "Code generation, review, debugging, scripts",
      "precedence": 60,
      "target_class": "large",
      "want_strengths": ["code"],
      "prefer_provider": "groq",
      "strong": [
        "code", "function", "debug", "refactor", "bug", "stack trace", "traceback",
        "python", "javascript", "typescript", "rust", "golang", "kotlin", "swift",
        "sql", "html", "css", "react", "component", "endpoint", "regex",
        "write a script", "write a function", "hello world", "unit test",
        "compile", "runtime error", "syntax error", "pull request", "git ",
        "docker", "kubernetes", "terraform", "npm ", "pip ", "cargo "
      ],
      "weak": [
        "implement", "api", "script", "shell", "bash", "program", "algorithm",
        "class", "module", "import", "build", "lint", "test", "library",
        "framework", "deploy", "parse", "server", "database", "query"
      ]
    },
    "reasoning": {
      "description": "Complex reasoning, planning, research, analysis",
      "precedence": 45,
      "target_class": "large",
      "want_strengths": ["reasoning"],
      "prefer_provider": "gemini",
      "strong": [
        "analyze", "analysis", "pros and cons", "trade-off", "tradeoff",
        "step by step", "think through", "chain of thought", "reason about",
        "best approach", "compare", "evaluate", "recommend", "strategy",
        "architecture", "root cause", "why does", "how does", "explain why",
        "break down", "decide between", "prove", "derive"
      ],
      "weak": [
        "plan", "research", "complex", "decision", "investigate", "explore",
        "study", "probability", "math", "calculate", "logic", "design", "assess"
      ]
    },
    "creative": {
      "description": "Creative writing, brainstorming, ideation",
      "precedence": 40,
      "target_class": "large",
      "want_strengths": ["creative"],
      "prefer_provider": "groq",
      "strong": [
        "poem", "poetry", "story", "song", "lyrics", "novel", "fiction",
        "brainstorm", "ad copy", "tagline", "headline", "screenplay",
        "short story", "come up with names", "creative"
      ],
      "weak": [
        "write", "ideas", "invent", "imagine", "concept", "metaphor",
        "outline", "draft", "marketing", "slogan", "pitch"
      ]
    },
    "long_context": {
      "description": "Tasks over long documents or large context",
      "precedence": 55,
      "target_class": "large",
      "want_strengths": ["long_context"],
      "prefer_provider": "gemini",
      "min_context": 500000,
      "strong": [
        "long document", "large file", "whole file", "entire codebase",
        "entire document", "page document", "many pages", "full transcript",
        "long article", "full document", "big context", "context window",
        "across all files", "whole repo"
      ],
      "weak": ["entire", "transcript", "document", "chapters", "pages", "verbose"]
    }
  },
  "scoring": {
    "keyword_strong": 10,
    "keyword_weak": 3,
    "class_exact_bonus": 40,
    "class_step_under_penalty": -16,
    "class_step_over_penalty": -9,
    "strength_match_bonus": 9,
    "strength_match_cap": 27,
    "context_shortfall_penalty": -45,
    "prefer_provider_bonus": 6,
    "free_provider_bonus": 5,
    "provider_order_bonus_step": 1.5,
    "rate_limit_penalty_per_hit": -20
  },
  "ambiguity": {
    "ask_when_margin_below": 6,
    "ask_when_confidence_below": 45,
    "default_task_type": "simple",
    "prompt_template": "This task could be [{options}]. Which fits best? (or say 'other' and describe it)"
  }
}
